{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "k10s",
  "version": "0.1.1",
  "identifier": "io.dumkin.k10s",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "k10s",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 },
        "backgroundColor": "#0b0c0e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Danil Dumkin",
    "copyright": "Copyright © 2026 Danil Dumkin",
    "homepage": "https://github.com/dumkin/k10s",
    "category": "DeveloperTool",
    "shortDescription": "Multi-cluster Kubernetes desktop client",
    "longDescription": "A keyboard-first Kubernetes client for fleets of clusters: every cluster in one live table, made for namespace-restricted RBAC, with logs, terminals, port-forwards, Helm and object comparison across clusters. No account, no telemetry.",
    "license": "AGPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "appimage": {
        "files": { "/usr/share/metainfo/io.dumkin.k10s.appdata.xml": "../../packaging/linux/io.dumkin.k10s.appdata.xml" }
      },
      "deb": {
        "files": { "/usr/share/metainfo/io.dumkin.k10s.appdata.xml": "../../packaging/linux/io.dumkin.k10s.appdata.xml" }
      },
      "rpm": {
        "files": { "/usr/share/metainfo/io.dumkin.k10s.appdata.xml": "../../packaging/linux/io.dumkin.k10s.appdata.xml" }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
